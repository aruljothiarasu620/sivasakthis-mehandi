# Admin login (REQUIRED – change both!)
ADMIN_PASSWORD=change-this-strong-password
# Long random string used to sign the admin session cookie (e.g. `openssl rand -hex 32`)
AUTH_SECRET=change-this-to-a-long-random-string
# Public site URL (for SEO / sitemap)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Optional: where the database and uploaded photos live (use a persistent disk in production)
# DATA_DIR=/var/data/mehndi
